FROM node:24-trixie-slim@sha256:7f486cabe892bff8fef04c0f7da8dba84a560be3e4e2740b7a86afc57ebec315
WORKDIR /app
RUN apt-get update -qq && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*
RUN git config --global url."https://github.com/".insteadOf ssh://git@github.com/
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && \
    npm cache clean --force && \
    apt-get purge -y --auto-remove git && \
    rm -rf /var/lib/apt/lists/* /root/.npm
COPY server.js ./
EXPOSE 8080
USER node
ENTRYPOINT ["node", "server.js"]
