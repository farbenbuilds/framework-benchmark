FROM ruby:3.3-bookworm
WORKDIR /app
RUN apt-get update -qq && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
COPY Gemfile ./
RUN bundle install
COPY config.ru ./
EXPOSE 8080
ENV RUBY_YJIT_ENABLE=1
ENTRYPOINT ["sh", "-c", "exec falcon serve --bind http://0.0.0.0:8080 --count ${BENCHMARK_WORKERS:-1}"]
