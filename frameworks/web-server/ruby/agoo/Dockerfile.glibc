FROM ruby:3.3-bookworm@sha256:b899e7de6ffa6e974d947202d3ce2ac921c12e46c14cff3106214079388dcff4
WORKDIR /app
ENV RUBY_YJIT_ENABLE=1
RUN apt-get update -qq && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
COPY Gemfile ./
RUN bundle install
COPY server.rb ./
EXPOSE 8080
ENTRYPOINT ["ruby", "server.rb"]
