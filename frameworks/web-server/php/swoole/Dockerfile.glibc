FROM php:8.3-cli-bookworm@sha256:c24b55afdf860c874b9ec6267ced132ff52de97d308ab08e6cf41e8596e509f7
RUN apt-get update -qq && apt-get install -y --no-install-recommends libssl-dev libcurl4-openssl-dev && rm -rf /var/lib/apt/lists/*
RUN pecl install swoole && docker-php-ext-enable swoole
WORKDIR /app
COPY server.php ./
EXPOSE 8080
ENTRYPOINT ["php", "server.php"]
