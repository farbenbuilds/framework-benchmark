FROM php:8.5.11-cli-alpine3.24@sha256:93684051146ec037620855feb77f278090bde45ddc030801cd3f2a7685bc4deb
RUN apk add --no-cache --virtual .build-deps $PHPIZE_DEPS linux-headers openssl-dev && \
    pecl install swoole-6.2.3 && docker-php-ext-enable swoole && \
    apk del .build-deps && \
    apk add --no-cache libstdc++ && \
    rm -rf /tmp/pear
WORKDIR /app
COPY server.php ./
EXPOSE 8080
USER 10001:10001
ENTRYPOINT ["php", "server.php"]
