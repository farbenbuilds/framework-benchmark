FROM alpine:3.21 AS builder
WORKDIR /usr/src/app
RUN apk add --no-cache ca-certificates curl git xz
RUN curl -fsSL https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz | tar -xJ -C /opt && ln -s /opt/zig-x86_64-linux-0.16.0/zig /usr/local/bin/zig
RUN git init /opt/dusty && git -C /opt/dusty remote add origin https://github.com/lalinsky/dusty.git && git -C /opt/dusty fetch --depth 1 origin 494f856d1795cfbf6180f6f8e5a80665d8114174 && git -C /opt/dusty checkout --detach FETCH_HEAD
COPY . .
RUN ln -s /opt/dusty dusty && zig build -Doptimize=ReleaseFast

FROM alpine:3.21
WORKDIR /app
RUN apk add --no-cache ca-certificates curl
COPY --from=builder /usr/src/app/zig-out/bin/server /app/server
EXPOSE 8080
ENTRYPOINT ["/app/server"]
