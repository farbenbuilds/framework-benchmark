FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f AS builder
WORKDIR /usr/src/app
RUN apt-get update -qq && apt-get install -y --no-install-recommends ca-certificates curl git xz-utils && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/zig.tar.xz https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz && \
    tar -xJf /tmp/zig.tar.xz -C /opt && rm /tmp/zig.tar.xz && \
    ln -s /opt/zig-x86_64-linux-0.16.0/zig /usr/local/bin/zig
RUN git init /opt/dusty && git -C /opt/dusty remote add origin https://github.com/lalinsky/dusty.git && git -C /opt/dusty fetch --depth 1 origin 9f74f97b91774c1f6e8c66da03403deb89be05a3 && git -C /opt/dusty checkout --detach FETCH_HEAD
COPY . .
RUN ln -s /opt/dusty dusty && zig build -Doptimize=ReleaseFast

FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
WORKDIR /app
RUN apt-get update -qq && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/src/app/zig-out/bin/server /app/server
EXPOSE 8080
USER 10001:10001
ENTRYPOINT ["/app/server"]
