FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS builder
WORKDIR /usr/src/app
RUN apk add --no-cache ca-certificates curl git xz zlib-dev
RUN curl -fsSL -o /tmp/zig.tar.xz https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz && \
    tar -xJf /tmp/zig.tar.xz -C /opt && rm /tmp/zig.tar.xz && \
    ln -s /opt/zig-x86_64-linux-0.16.0/zig /usr/local/bin/zig
RUN git init /opt/swerver && git -C /opt/swerver remote add origin https://github.com/justinGrosvenor/swerver.git && git -C /opt/swerver fetch --depth 1 origin a4e469301d4a47fb3f4552b7cbd58d135fac8c9a && git -C /opt/swerver checkout --detach FETCH_HEAD
COPY src/main.zig /opt/swerver/src/main.zig
RUN cd /opt/swerver && zig build -Doptimize=ReleaseFast

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
WORKDIR /app
RUN apk add --no-cache ca-certificates
COPY --from=builder /opt/swerver/zig-out/bin/swerver /app/server
EXPOSE 8080
USER 10001:10001
ENTRYPOINT ["/app/server"]
