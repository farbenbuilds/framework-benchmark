FROM alpine:3.21 AS builder
WORKDIR /usr/src/app
RUN apk add --no-cache ca-certificates curl git xz
RUN curl -sSL https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz | tar -xJ -C /opt && ln -s /opt/zig-x86_64-linux-0.16.0/zig /usr/local/bin/zig
RUN git config --global url."https://github.com/".insteadOf git@github.com: && git init /opt/zuws && git -C /opt/zuws remote add origin https://github.com/harmony-co/zuws.git && git -C /opt/zuws fetch --depth 1 origin cb360ea5cf6706660b60ba5e79ea3b0a61899cc6 && git -C /opt/zuws checkout --detach FETCH_HEAD && git -C /opt/zuws submodule update --init --depth 1 --recursive && sed -i 's/return c.uws_ws(self, pattern, b);/return c.uws_ws(self, @ptrCast(pattern), b);/' /opt/zuws/src/app.zig && sed -i 's/)(self, pattern, handler);/)(self, @ptrCast(pattern), handler);/' /opt/zuws/src/app.zig
COPY . .
RUN ln -s /opt/zuws zuws
RUN zig build -Doptimize=ReleaseFast

FROM alpine:3.21
WORKDIR /app
RUN apk add --no-cache ca-certificates curl
COPY --from=builder /usr/src/app/zig-out/bin/server /app/server
EXPOSE 8080
ENTRYPOINT ["/app/server"]
