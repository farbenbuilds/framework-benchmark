FROM alpine:3.21 AS builder
WORKDIR /usr/src/app
RUN apk add --no-cache ca-certificates curl xz
RUN curl -sSL https://ziglang.org/download/0.13.0/zig-linux-x86_64-0.13.0.tar.xz | tar -xJ -C /opt && ln -s /opt/zig-linux-x86_64-0.13.0/zig /usr/local/bin/zig
COPY . .
RUN zig build -Doptimize=ReleaseFast

FROM alpine:3.21
WORKDIR /app
RUN apk add --no-cache ca-certificates curl
COPY --from=builder /usr/src/app/zig-out/bin/server /app/server
EXPOSE 8080
ENTRYPOINT ["/app/server"]
