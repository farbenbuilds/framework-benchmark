FROM python:3.12-alpine3.21@sha256:d4f9227f21409479c7fe92288f2e40b1a56ae591c8ad3b5446dfeaef90f67857
WORKDIR /app
RUN apk add --no-cache gcc musl-dev linux-headers
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py ./
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port 8080 --loop uvloop --http httptools --no-access-log --workers ${BENCHMARK_WORKERS:-1}"]
