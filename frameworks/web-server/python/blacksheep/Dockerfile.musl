FROM python:3.13.14-alpine3.24@sha256:399babc8b49529dabfd9c922f2b5eea81d611e4512e3ed250d75bd2e7683f4b0
WORKDIR /app
COPY requirements.txt ./
RUN apk add --no-cache gcc musl-dev linux-headers && \
    pip install --no-cache-dir -r requirements.txt && \
    apk del gcc musl-dev linux-headers
COPY app.py ./
EXPOSE 8080
USER 10001:10001
ENTRYPOINT ["sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port 8080 --loop uvloop --http httptools --no-access-log --workers ${BENCHMARK_WORKERS:-1}"]
