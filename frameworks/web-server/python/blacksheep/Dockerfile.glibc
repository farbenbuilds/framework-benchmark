FROM python:3.12-slim-bookworm
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py ./
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port 8080 --loop uvloop --http httptools --no-access-log --workers ${BENCHMARK_WORKERS:-1}"]
