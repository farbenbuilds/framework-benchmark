FROM python:3.13.14-slim-trixie@sha256:9662417aace5ae7b8e2609cce472b72a8958e134ba372808abe9cc1a0c0125e6
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py ./
EXPOSE 8080
USER 10001:10001
ENTRYPOINT ["sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port 8080 --loop uvloop --http httptools --no-access-log --workers ${BENCHMARK_WORKERS:-1}"]
