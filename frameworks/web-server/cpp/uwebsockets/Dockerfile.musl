FROM alpine:3.21@sha256:ce64758a109eb420d874a118f87920e625e12d3634e03b4a5573fd9f6e5d3507 AS build
WORKDIR /src
RUN apk add --no-cache cmake g++ git make
RUN git clone --depth 1 --branch v20.69.0 --recurse-submodules \
    https://github.com/uNetworking/uWebSockets.git /opt/uwebsockets && \
    make -C /opt/uwebsockets/uSockets
COPY CMakeLists.txt main.cpp ./
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel

FROM alpine:3.21@sha256:ce64758a109eb420d874a118f87920e625e12d3634e03b4a5573fd9f6e5d3507
WORKDIR /app
RUN apk add --no-cache libstdc++
COPY --from=build /src/build/server ./server
EXPOSE 8080
ENTRYPOINT ["/app/server"]
