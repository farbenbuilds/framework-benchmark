FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS build
WORKDIR /src
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    cmake g++ git make && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch v20.69.0 --recurse-submodules \
    https://github.com/uNetworking/uWebSockets.git /opt/uwebsockets && \
    make -C /opt/uwebsockets/uSockets
COPY CMakeLists.txt main.cpp ./
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
WORKDIR /app
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    libstdc++6 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/build/server ./server
EXPOSE 8080
ENTRYPOINT ["/app/server"]
