FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS build
WORKDIR /src
RUN apk add --no-cache boost-dev cmake g++ git make openssl-dev zlib-dev
RUN git init /opt/hical && git -C /opt/hical remote add origin \
    https://github.com/Hical61/Hical.git && git -C /opt/hical fetch --depth 1 \
    origin 71832c9e276a7de8a706474a5dccf34c33992c94 && \
    git -C /opt/hical checkout --detach FETCH_HEAD
COPY CMakeLists.txt main.cpp ./
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
WORKDIR /app
RUN apk add --no-cache boost-json libstdc++ openssl zlib
COPY --from=build /src/build/server /app/server
EXPOSE 8080
USER 10001:10001
ENTRYPOINT ["/app/server"]
